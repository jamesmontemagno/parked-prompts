{
  "name": "@parked-prompts/core",
  "version": "0.1.0",
  "private": true,
  "description": "Store format, attachments, and repo matching for Parked Prompts. No vscode dependency.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
